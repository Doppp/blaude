{
  "required": {
    "colors": ["--bl-bg", "--bl-surface", "--bl-ink", "--bl-ink-muted", "--bl-accent", "--bl-accent-ink", "--bl-rule", "--bl-good", "--bl-warn", "--bl-bad", "--bl-chart-1", "--bl-chart-2", "--bl-chart-3", "--bl-chart-4", "--bl-chart-5", "--bl-chart-6"],
    "fonts": ["--bl-font-body", "--bl-font-heading", "--bl-font-mono"],
    "sizes": ["--bl-size-body", "--bl-measure", "--bl-radius"],
    "spacing": ["--bl-s1", "--bl-s2", "--bl-s3", "--bl-s4"]
  },
  "optional": {
    "colors": ["--bl-term-bg", "--bl-term-ink", "--bl-term-dim", "--bl-term-ok", "--bl-term-key", "--bl-term-rule"]
  },
  "spacingScale": { "--bl-s1": "8px", "--bl-s2": "16px", "--bl-s3": "24px", "--bl-s4": "40px" },
  "limits": { "--bl-size-body": [16, 18], "--bl-measure": [0, 720] },
  "contrast": [
    { "fg": "--bl-ink", "bg": "--bl-bg", "min": 4.5 },
    { "fg": "--bl-ink", "bg": "--bl-surface", "min": 4.5 },
    { "fg": "--bl-ink-muted", "bg": "--bl-bg", "min": 4.5 },
    { "fg": "--bl-ink-muted", "bg": "--bl-surface", "min": 4.5 },
    { "fg": "--bl-accent", "bg": "--bl-bg", "min": 3 },
    { "fg": "--bl-accent-ink", "bg": "--bl-accent", "min": 4.5 },
    { "fg": "--bl-good", "bg": "--bl-surface", "min": 3 },
    { "fg": "--bl-warn", "bg": "--bl-surface", "min": 3 },
    { "fg": "--bl-bad", "bg": "--bl-surface", "min": 3 },
    { "fg": "--bl-term-ink", "bg": "--bl-term-bg", "min": 4.5, "optional": true },
    { "fg": "--bl-term-dim", "bg": "--bl-term-bg", "min": 4.5, "optional": true }
  ]
}
